{
  "name": "nodelbrot",
  "private": true,
  "description": "Mandelbrot set explorer",
  "scripts": {
    "dev": "node dev/server.js --open",
    "check": "node dev/workerCheck.js",
    "build": "node build/build.js",
    "dev:built": "node build/build.js && node dev/server.js --built --open",
    "check:built": "node build/build.js && node dev/workerCheck.js --built",
    "test": "jasmine --config=dev/jasmine.json"
  },
  "devDependencies": {
    "jasmine": "^7.0.0",
    "uglify-js": "^3.19.3"
  },
  "engines": {
    "node": ">=24"
  }
}
